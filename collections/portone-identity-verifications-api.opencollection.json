            "url": "https://api.portone.io/identity-verifications/:identityVerificationId/confirm",
            "params": [
              {
                "name": "identityVerificationId",
                "value": "",
                "type": "path",
                "description": "본인인증 아이디"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "본인인증 확인\n\n요청된 본인인증에 대한 확인을 진행합니다."
        },
