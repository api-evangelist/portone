{
  "opencollection": "1.0.0",
  "info": {
    "name": "PortOne B2b Payment Gateways API",
    "version": "1.16.0"
  },
  "items": [
    {
      "info": {
        "name": "Payment Gateways",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "PG사 카드 프로모션 조회 API",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.portone.io/payment-gateways/card-promotion",
            "params": [
              {
                "name": "channelKey",
                "value": "",
                "type": "query",
                "description": "채널 키\n\n조회하고자 하는 채널의 키"
              },
              {
                "name": "amount",
                "value": "",
                "type": "query",
                "description": "결제 금액\n\n결제 금액입니다. 해당 결제 금액 기준 이용 가능한 프로모션 목록이 조회됩니다."
              },
              {
                "name": "cardCompany",
                "value": "",
                "type": "query",
                "description": "카드사 필터\n\n조회할 카드사입니다. 값을 입력하지 않으면 카드사 필터링이 적용되지 않습니다."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "PG사 카드 프로모션 조회 API\n\n주어진 채널에 대해 PG사에서 제공하는 카드 프로모션 목록을 조회합니다.\n해당 API는 현재 특정 PG사(KCP_V2)에 대해서만 지원되며, 지원 여부는 포트원 기술지원팀에 문의 부탁드립니다."
        }
      ]
    }
  ],
  "bundled": true
}